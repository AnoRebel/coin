{
  "network": "arce:devnet",
  "trusted_height": 1,
  "validators": [
    {"id": "v1", "power": 2},
    {"id": "v2", "power": 1},
    {"id": "v3", "power": 1}
  ],
  "certificate": {
    "height": 2,
    "round": 1,
    "block_hash": "block-2"
  },
  "cases": [
    {
      "name": "valid",
      "signers": ["v1", "v2"],
      "expect": {"signed": 3}
    },
    {
      "name": "insufficient_quorum",
      "signers": ["v3"],
      "expect": {"error": "insufficient quorum", "signed": 1}
    },
    {
      "name": "outdated_set",
      "height": 1,
      "signers": ["v1", "v2"],
      "expect": {"error": "outdated"}
    },
    {
      "name": "forged_signature",
      "signers": ["v1", "v2"],
      "forge": "v1",
      "expect": {"error": "forged"}
    },
    {
      "name": "unknown_signer",
      "signers": ["v1", "v2"],
      "unknown": "v4",
      "expect": {"error": "unknown validator"}
    },
    {
      "name": "duplicate_signer",
      "signers": ["v1", "v1", "v2"],
      "expect": {"error": "duplicate validator"}
    }
  ]
}
