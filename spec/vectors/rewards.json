{
  "cases": [
    {
      "name": "proportional with commission and jailed exclusion",
      "budget": 10000,
      "treasury_bps": 1000,
      "epoch": 3,
      "validators": [
        {
          "address": "v1",
          "status": "active",
          "commission_bps": 1000,
          "delegations": {
            "v1": 1000,
            "d1": 1000
          }
        },
        {
          "address": "v2",
          "status": "active",
          "commission_bps": 0,
          "delegations": {
            "v2": 2000
          }
        },
        {
          "address": "v3",
          "status": "jailed",
          "commission_bps": 500,
          "delegations": {
            "v3": 3000
          }
        }
      ],
      "expect": {
        "treasury": 1000,
        "total": 10000,
        "validators": {
          "v1": {
            "stake": 2000,
            "commission": 450,
            "total": 4500,
            "delegators": {
              "v1": 2025,
              "d1": 2025
            }
          },
          "v2": {
            "stake": 2000,
            "commission": 0,
            "total": 4500,
            "delegators": {
              "v2": 4500
            }
          }
        }
      }
    },
